# MCP server credentials. Copy to .env and fill in; .env is gitignored.
# Consumed by .mcp.json via ${VAR} expansion.

# https://www.perplexity.ai/account/api/group
PERPLEXITY_API_KEY=

# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Playwright needs no key — Chromium is preinstalled in Claude Code web sessions
# (PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers). Locally, run: npx playwright install chromium
